{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "dom"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {}
  },
  "include": ["packages/*/src"],
  "exclude": ["node_modules", "packages/*/dist"]
}
